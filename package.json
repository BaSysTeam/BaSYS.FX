    "dates",
    "tables",
    "basys"
  ],
  "author": "Michael Zyubin",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "rollup": "^4.34.9",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "publishConfig": {
