  "description": "BaSYS.FX is an extended set of functions for working with dates, tables, and utilities in JavaScript.",
  "main": "dist/basys-fx.umd.js",
  "module": "dist/basys-fx.esm.js",
  "browser": "dist/basys-fx.iife.js",
